# Google Gemini API Key
GENAI_API_KEY=your-gemini-api-key-here

# Sarvam AI API Key (for Indian medical OCR)
SARVAM_API_KEY=your-sarvam-api-key-here

# Frontend URL (for CORS)
FRONTEND_URL=

# Must be the SAME value as SECRET_KEY in backend/.env (used to check login tokens)
JWT_SECRET_KEY=same-as-django-secret-key

# Shared secret between django and this service, set the same value in backend/.env
INTERNAL_API_KEY=any-long-random-string

# Postgres connection for pgvector + chat history (leave empty to use local chroma + json file)
DATABASE_URL=
